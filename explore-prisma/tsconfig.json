{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*", "src/lib", "src/lib/prisma.ts", "generated"],
  "exclude": ["node_module", "dist", "generated"]
}
